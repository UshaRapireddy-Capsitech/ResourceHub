  "components": {
    "schemas": {
      "CreateUserDto": {
        "required": [
          "email",
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ResourceScope": {
        "enum": [
          "OnlyMe",
          "Custom",
          "OrgWide"
        ],
        "type": "string"
      },
      "ResourceStatus": {
        "enum": [
          "Draft",
          "Pending",
          "Approved",
          "Rejected"
        ],
        "type": "string"
      },
      "ReviewDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResourceStatus"
          },
          "reviewNote": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "enum": [
          "Admin",
          "Staff",
          "User"
        ],
        "type": "string"
      },
      "ShareDto": {
        "type": "object",
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/ResourceScope"
          },
          "userIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter JWT Bearer token only",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
